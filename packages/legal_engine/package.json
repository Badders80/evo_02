{
  "name": "@evo/legal_engine",
  "version": "1.0.0",
  "description": "Evolution Stables DSL legal compiler: PDS & Syndicate Agreement generator with SHA-256 vault hashing",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./pricing": {
      "types": "./src/pricing.ts",
      "default": "./src/pricing.ts"
    },
    "./pds": {
      "types": "./src/pds.ts",
      "default": "./src/pds.ts"
    },
    "./sa": {
      "types": "./src/sa.ts",
      "default": "./src/sa.ts"
    },
    "./compiler": {
      "types": "./src/compiler.ts",
      "default": "./src/compiler.ts"
    },
    "./validator": {
      "types": "./src/validator.ts",
      "default": "./src/validator.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./settlement": {
      "types": "./src/settlement.ts",
      "default": "./src/settlement.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "tsx tests/legal_engine.test.ts && tsx tests/settlement.test.ts"
  },
  "dependencies": {
    "@evo/db_models": "workspace:*",
    "@evo/storage": "workspace:*",
    "@evo/brand_dna": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.8.2"
  }
}